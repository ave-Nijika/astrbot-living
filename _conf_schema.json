                        "hint": "清醒待机结束、继续入睡时告知主人的一句话（零 token）。留空 = 安静入睡不告知。",
                        "type": "string",
                        "default": "",
                        "invisible": true
                    },
                    "wake_source": {
                        "description": "吵醒计数来源",
                        "hint": "all=所有消息都算吵（群聊里别人聊天也算）；owner_only=只数主人（owner_id 留空时自动取管理员 ID 的第一位）。",
                        "type": "string",
                        "options": [
                            "all",
                            "owner_only"
                        ],
                        "default": "all",
                        "invisible": true
                    },
                    "owner_id": {
                        "description": "主人 ID（wake_source=owner_only 时用）",
                        "hint": "填主人的用户 ID；留空时自动认主（取 AstrBot 管理员 ID 的第一位，手填优先）。wake_source 为 all 时忽略。",
                        "type": "string",
                        "default": "",
                        "invisible": true
                    },
                    "sleep_mute_replies": {
                        "description": "睡眠期静默回复",
                        "hint": "开启后休眠窗内收到的消息会被拦截，AstrBot 与所有插件都不回复（真正休息）。达到吵醒阈值的那条消息与本插件命令不受影响。关掉则休眠期照常回复、只是插件自己不活动。",
                        "type": "bool",
                        "default": true,
                        "invisible": true
                    },
                    "dream_probability": {
                        "description": "做梦概率（0-1）",
                        "hint": "醒来后按此概率生成一条梦话，写入记忆（默认不外发）。",
                        "type": "float",
                        "default": 0.3,
                        "invisible": true
                    },
                    "schedule_reminder_enabled": {
                        "description": "起床约定感知",
                        "hint": "感知主人消息里的起床约定（如\"明早 8 点起\"），作为入睡与醒来的软性参考。",
                        "type": "bool",
                        "default": true,
                        "invisible": true
                    },
                    "schedule_discipline": {
                        "description": "守时自觉性（0-1）",
                        "hint": "越高越把约定当回事：约定临近时睡意加成越强。调低更容易熬夜睡过头。",
                        "type": "float",
                        "default": 0.6,
                        "invisible": true
                    },
                    "schedule_extract_strictness": {
                        "description": "约定提取严格度（0-1）",
                        "hint": "LLM 判定\"这是起床约定\"的置信度门槛，越高越难记录。默认 0.7。",
                        "type": "float",
                        "default": 0.7,
                        "invisible": true
                    },
                    "schedule_trigger_words": {
                        "description": "约定触发词表",
                        "hint": "消息命中任一词才启动约定提取（本地预筛，零 LLM 成本）。",
                        "type": "list",
                        "default": [
                            "起床",
                            "早起",
                            "叫我",
                            "叫醒",
                            "唤醒",
                            "早点叫",
                            "早八",
                            "wake",
                            "alarm"
                        ],
                        "invisible": true
                    }
                },
                "invisible": true
            },
            "capabilities": {
                "description": "能力开关",
                "type": "object",
                "items": {
                    "sandbox_timeout_seconds": {
                        "description": "沙箱超时（秒）",
                        "type": "int",
                        "default": 10,
                        "invisible": true
                    },
                    "cooldown_between_activities_hours": {
                        "description": "两次活动最小间隔（小时）",
                        "hint": "刚忙完一件事需要歇一会儿，隔多久才允许下一次冲动。",
                        "type": "float",
                        "default": 2.0,
                        "invisible": true
                    }
                },
                "invisible": true
            },
            "memory": {
                "description": "记忆",
                "type": "object",
                "items": {
                    "backend": {
                        "description": "记忆后端",
