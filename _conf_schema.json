{
    "preset": {
        "description": "新手设置（常用旋钮，改这里就够了；改动几秒内生效）",
        "type": "object",
        "items": {
            "preset_activity_level": {
                "description": "它独处时折腾的频率",
                "hint": "安静=一天最多忙 1 次；正常=闲着才找点事做（每天两三次）；活跃=经常自己找乐子（不设上限）。改的是它心血来潮的频率，不影响聊天回复。",
                "type": "string",
                "options": [
                    "quiet",
                    "normal",
                    "active"
                ],
                "default": "normal",
                "invisible": true
            },
            "preset_talk_frequency": {
                "description": "它主动找你说话的频率",
                "hint": "很少=一天至多 3 句、间隔至少一个半小时；正常=一天至多 10 句；经常=一天至多 30 句。只管它主动分享，你找它聊不受影响。",
                "type": "string",
                "options": [
                    "rare",
                    "normal",
                    "often"
                ],
                "default": "normal",
                "invisible": true
            },
            "preset_capability_tier": {
                "description": "它有多少手脚",
                "hint": "只看=只能上网浏览和搜索；能动手=还能在自己的专属工作区里读写文件、写小程序；全放开=再加上这台电脑上的命令行。越高越能干，也越需要信任。",
                "type": "string",
                "options": [
                    "watch",
                    "home",
                    "full"
                ],
                "default": "watch",
                "invisible": true
            },
            "preset_write_level": {
                "description": "它在网上能做到什么程度",
                "hint": "只看=光看不点；点点看=能点链接、翻页、填表单但不提交；能评论=可以点赞、评论、提交表单；全权=发帖、私信、下单都行（一次授权，设了就生效）。",
                "type": "string",
                "options": [
                    "read",
                    "browse",
                    "comment",
                    "full"
                ],
                "default": "read",
                "invisible": true
            },
            "preset_topic_taste": {
                "description": "它聊天的口味",
                "hint": "专一=认定喜欢的方向会钻研很久；均衡=正常换换话题；发散=隔一阵就想换个完全没碰过的新方向。影响它独处时选话题的跨度。",
                "type": "string",
                "options": [
                    "focused",
                    "balanced",
                    "diverse"
                ],
                "default": "balanced",
                "invisible": true
            },
            "preset_free_activity": {
                "description": "允许它自由发挥",
                "hint": "开=它偶尔会完全自己决定干什么（探索欲）；关=只做固定的几样活动（冲浪/读文章/小游戏/翻记忆/回味）。",
                "type": "string",
                "options": [
                    "on",
                    "off"
                ],
                "default": "on",
                "invisible": true
            },
            "preset_decision_mode": {
                "description": "让它想事情花多少心思",
                "hint": "省着点=按固定规则选活动，几乎零开销；正常=规则筛选+AI 复核怎么做（推荐）；放开想=每件事都让 AI 自己想，最有灵气也最费 token。",
                "type": "string",
                "options": [
                    "economy",
                    "normal",
                    "rich"
                ],
                "default": "normal",
                "invisible": true
            },
            "preset_model": {
                "description": "它独处时用哪个 AI 大脑",
                "hint": "填一个你在 AstrBot 里配置好的模型 provider id（留空=用当前聊天模型）。强烈建议给它单独配一个便宜些的模型，避免自主活动烧聊天模型的额度。",
                "type": "string",
                "default": "",
                "invisible": true
            },
            "life_extra": {
                "description": "它的性格与兴趣底色",
                "hint": "它独处时的性格底色与兴趣倾向，写得越具体越有味道（作息习惯、喜欢什么、讨厌什么…）。这是背景参考不是任务清单——影响它的风格和口味，但不会把话题锁死。可自由修改。",
                "type": "text",
                "default": "# 生活背景参考（可自由修改，影响它独处时的行为口味，不必围绕它选题）\n- 作息习惯：喜欢安静，通常在深夜有精神\n- 兴趣倾向：对技术、宇宙、咖啡、独立游戏感兴趣\n- 性格底色：温和、有点慢热，好奇心强\n- 不喜欢：被打断、重复劳动",
                "invisible": true
            }
        }
    },
