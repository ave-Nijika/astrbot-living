{
  "decision": {
    "description": "决策层（M1 生效，M0 先占位）",
    "type": "object",
    "items": {
      "decision_mode": {
        "description": "决策模式",
        "hint": "rules=纯规则零成本；hybrid=规则筛+LLM复核；llm=全LLM自由决策。M0 阶段不生效。",
        "type": "string",
        "options": ["rules", "hybrid", "llm"],
        "default": "hybrid"
      },
      "impulse_check_interval_minutes": {
        "description": "冲动检查间隔（分钟）",
        "hint": "主循环每隔多少分钟做一次'要不要干点什么'的检查。判定是纯内存/SQLite 读，零 API 消耗；活动频率实际由无聊曲线控制，心跳可以调得很勤。",
        "type": "int",
        "default": 5
      },
      "activity_probability": {
        "description": "冲动最高概率（0-1）",
        "hint": "无聊曲线的封顶值：闲得越久越接近这个概率，过了封顶时间后恒定。",
        "type": "float",
        "default": 0.8
      },
      "activity_probability_min": {
        "description": "冲动最低概率（0-1）",
        "hint": "无聊曲线的起点：冷却刚结束时用这个低概率，避免刚忙完又立刻想动。",
        "type": "float",
        "default": 0.1
      },
      "activity_probability_ramp_minutes": {
        "description": "无聊曲线爬升时间（分钟）",
        "hint": "从最低概率爬升到最高概率所需的时间（自冷却结束起算）。0 = 不爬升，直接用最高概率。",
        "type": "float",
        "default": 60
      },
      "daily_impulse_limit": {
        "description": "每日冲动上限",
        "hint": "0 = 不限制。",
        "type": "int",
        "default": 3
      },
      "single_run_token_budget": {
        "description": "单次活动 token 预算",
        "hint": "单次自主活动允许消耗的最大 token 数。",
        "type": "int",
        "default": 20000
      },
      "max_tool_rounds": {
        "description": "单循环最大工具轮数",
        "type": "int",
        "default": 8
      },
      "max_run_seconds": {
        "description": "单循环最长时长（秒）",
        "type": "int",
        "default": 300
      },
      "agent_activities": {
        "description": "走 agent 模式的活动",
        "hint": "列表内的活动由 LLM 拿着工具集（搜索/抓取/沙箱/记忆）自己决定怎么玩，其余走脚本模式。受 single_run_token_budget 硬闸保护。",
        "type": "list",
        "default": ["surf", "read", "game"]
      }
    }
  },
  "output_gate": {
    "description": "输出闸门",
    "type": "object",
    "items": {
      "daily_message_limit": {
        "description": "每日主动消息上限",
        "hint": "0 = 不限制。",
        "type": "int",
        "default": 10
      },
      "message_min_interval_minutes": {
        "description": "两条主动消息最小间隔（分钟）",
        "type": "int",
        "default": 30
      },
      "target_sessions": {
        "description": "输出目标会话列表",
        "hint": "每行一个 unified_msg_origin（格式：平台:消息类型:会话ID），留空则不主动发消息。",
        "type": "text",
        "default": ""
      },
      "quiet_hours": {
        "description": "静默时段（可选）",
        "hint": "格式 'HH:MM-HH:MM'，该时段不发主动消息。与休眠无关。",
        "type": "string",
        "default": ""
      }
    }
  },
  "sleep": {
    "description": "休眠（M3 生效，M0 先占位）",
    "type": "object",
    "items": {
      "sleep_window": {
        "description": "作息窗口",
        "hint": "格式 'HH:MM-HH:MM'。",
        "type": "string",
        "default": "00:30-08:00"
      },
      "fatigue_threshold": {
        "description": "疲惫阈值（0-100）",
        "type": "int",
        "default": 80
      },
      "fatigue_rate_per_hour": {
        "description": "疲惫积累速率（每小时）",
        "type": "float",
        "default": 4.0
      },
      "sleep_debt_decay_per_day": {
        "description": "睡眠债每日消退量",
        "type": "float",
        "default": 30.0
      },
      "wake_n_messages": {
        "description": "吵醒所需消息条数",
        "type": "int",
        "default": 3
      },
      "wake_window_minutes": {
        "description": "吵醒判定时间窗（分钟）",
        "type": "int",
        "default": 10
      },
      "grouchiness_percent": {
        "description": "起床气概率（0-100%）",
        "type": "int",
        "default": 20
      },
      "awake_standby_minutes": {
        "description": "清醒待机时长（分钟）",
        "hint": "被吵醒后保持清醒的时长；期间主人每发一条消息都会重新计时（滑动窗口）。待机期内正常聊天不静默，结束后若仍在睡眠窗则继续睡。",
        "type": "int",
        "default": 30
      },
      "wake_ack_message": {
        "description": "唤醒确认消息",
        "hint": "被吵醒后立刻回给主人的一句话（零延迟、不经过 LLM）。留空 = 不发送。",
        "type": "string",
        "default": "醒了，怎么了？"
      },
      "sleep_farewell_message": {
        "description": "入睡告别消息",
        "hint": "清醒待机结束、继续入睡时告知主人的一句话（零 token）。留空 = 安静入睡不告知。",
        "type": "string",
        "default": ""
      },
      "wake_source": {
        "description": "吵醒计数来源",
        "hint": "all=所有消息都算吵（群聊里别人聊天也算）；owner_only=只数主人（需配置 owner_id）。",
        "type": "string",
        "options": ["all", "owner_only"],
        "default": "all"
      },
      "owner_id": {
        "description": "主人 ID（wake_source=owner_only 时用）",
        "hint": "填主人的用户 ID；wake_source 为 all 时忽略。",
        "type": "string",
        "default": ""
      },
      "sleep_mute_replies": {
        "description": "睡眠期静默回复",
        "hint": "开启后休眠窗内收到的消息会被拦截，AstrBot 与所有插件都不回复（真正休息）。达到吵醒阈值的那条消息与本插件命令不受影响。关掉则休眠期照常回复、只是插件自己不活动。",
        "type": "bool",
        "default": true
      },
      "dream_probability": {
        "description": "做梦概率（0-1）",
        "hint": "醒来后按此概率生成一条梦话，写入记忆（默认不外发）。",
        "type": "float",
        "default": 0.3
      }
    }
  },
  "capabilities": {
    "description": "能力开关",
    "type": "object",
    "items": {
      "enable_search": {
        "description": "启用搜索能力",
        "type": "bool",
        "default": true
      },
      "enable_fetch": {
        "description": "启用网页抓取能力",
        "type": "bool",
        "default": true
      },
      "enable_sandbox": {
        "description": "启用沙箱代码执行能力",
        "type": "bool",
        "default": true
      },
      "enable_send": {
        "description": "启用主动发消息能力",
        "type": "bool",
        "default": true
      },
      "sandbox_timeout_seconds": {
        "description": "沙箱超时（秒）",
        "type": "int",
        "default": 10
      },
      "sandbox_max_memory_mb": {
        "description": "沙箱内存上限（MB，M0 预留，Windows 强化在 M4）",
        "type": "int",
        "default": 256
      },
      "cooldown_between_activities_hours": {
        "description": "两次活动最小间隔（小时）",
        "hint": "刚忙完一件事需要歇一会儿，隔多久才允许下一次冲动。",
        "type": "float",
        "default": 2.0
      }
    }
  },
  "persona": {
    "description": "人设补充",
    "type": "object",
    "items": {
      "life_extra": {
        "description": "生活补充设定",
        "hint": "主人格复用 AstrBot 已选 persona（总纲 D4），这里只补充'生活细节'：作息习惯、兴趣爱好、性格底色、讨厌的事等。会作为决策 LLM 的输入，影响它独处时的行为倾向。可自由修改。",
        "type": "text",
        "default": "# 生活补充设定（可自由修改，影响它独处时的行为倾向）\n- 作息习惯：喜欢安静，通常在深夜有精神\n- 兴趣爱好：对技术、宇宙、咖啡、独立游戏感兴趣\n- 性格底色：温和、有点慢热，好奇心强\n- 不喜欢：被打断、重复劳动"
      }
    }
  },
  "memory": {
    "description": "记忆",
    "type": "object",
    "items": {
      "backend": {
        "description": "记忆后端",
        "hint": "auto=优先探测 LivingMemory 插件，不可用则降级内置 SQLite；也可强制指定。",
        "type": "string",
        "options": ["auto", "livingmemory", "simple"],
        "default": "auto"
      },
      "default_importance": {
        "description": "活动记忆默认重要度（0-1）",
        "type": "float",
        "default": 0.5
      },
      "recall_count": {
        "description": "分享时召回记忆条数",
        "type": "int",
        "default": 5
      }
    }
  },
  "model": {
    "description": "模型",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "自主活动专用 Provider ID",
        "hint": "强烈建议配置一个与聊天模型不同的 provider，避免自主活动烧聊天模型的额度。留空则回退到默认聊天模型。",
        "type": "string",
        "default": ""
      },
      "fallback_chain": {
        "description": "模型故障转移链",
        "hint": "按顺序尝试的 provider id 列表；链尾会自动兜底全部已启用的聊天模型。默认聊天模型 404/限流/超时时自动切换，全部失败才算活动失败。",
        "type": "list",
        "default": []
      }
    }
  },
  "misc": {
    "description": "杂项",
    "type": "object",
    "items": {
      "log_level": {
        "description": "日志级别",
        "type": "string",
        "options": ["DEBUG", "INFO", "WARNING", "ERROR"],
        "default": "INFO"
      }
    }
  }
}
